{
  "name": "handball-statistik-saas",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handball-statistik-saas-db",
      "database_id": "d18a3b6e-cbc8-40ff-b776-0a0748745708"
    }
  ]
}
